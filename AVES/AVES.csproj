<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>x64</PlatformTarget>
		<ImplicitUsings>true</ImplicitUsings>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<Configurations>Debug R25;Debug R26</Configurations>
		<Configurations>$(Configurations);Release R25;Release R26</Configurations>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<!-- Revit configuration -->
	<PropertyGroup Condition="$(Configuration.Contains('R25'))">
		<RevitVersion>2025</RevitVersion>
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R26'))">
		<RevitVersion>2026</RevitVersion>
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>

	<!-- Launch configuration -->
	<PropertyGroup>
		<StartAction>Program</StartAction>
		<StartProgram>C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
		<StartArguments>/language ENG</StartArguments>
	</PropertyGroup>

	<!-- Build configuration -->
	<!-- https://github.com/Nice3point/Revit.Build.Tasks -->
	<PropertyGroup>
		<IsRepackable>false</IsRepackable>
		<!-- ✅ Only auto-deploys .addin and DLLs when building in Debug mode -->
		<DeployRevitAddin>$(Configuration.Contains('Debug'))</DeployRevitAddin>
	</PropertyGroup>

	<ItemGroup>
		<!-- Design handoff bundle: reference material, not production code.
		     It lives inside the project folder, so the SDK's default globs would
		     otherwise compile AvesUi.cs and treat AvesTheme.xaml as a Page.
		     AvesUi.cs does not build here (its bare `Color` is ambiguous against
		     Autodesk.Revit.DB.Color), and its tokens duplicate AVES.Core anyway. -->
		<Compile Remove="UI for plugins\**" />
		<Page Remove="UI for plugins\**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Resources\Icons16\*" />
		<None Remove="Resources\Icons32\*" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Resources\Icons16\*" />
		<EmbeddedResource Include="Resources\Icons32\*" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="Resources\Hilti Logo\company_logo.png" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Include="Resources\Hilti Logo\company_logo.png" />
	</ItemGroup>

	<ItemGroup>
		<!-- Revit References -->
		<PackageReference Include="Nice3point.Revit.Build.Tasks" Version="3.0.1" />
		<PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*" />
		<PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
	</ItemGroup>

	<ItemGroup>
		<!-- GLB writing for the Export GLB + BOM command -->
		<PackageReference Include="SharpGLTF.Toolkit" Version="1.0.7" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\Icons\RibbonIcon16.png" />
		<Resource Include="Resources\Icons\RibbonIcon32.png" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources\Files\Tooltips.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Tooltips.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\Files\Tooltips.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Tooltips.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<!-- ✅ Only runs file copy to AppData when building in Debug mode -->
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="$(Configuration.Contains('Debug'))">
		<Exec Command="if not exist &quot;%25AppData%25\Autodesk\Revit\Addins\2025\AVES&quot; mkdir &quot;%25AppData%25\Autodesk\Revit\Addins\2025\AVES&quot;&#xD;&#xA;xcopy &quot;$(TargetPath)&quot; &quot;%25AppData%25\Autodesk\Revit\Addins\2025\AVES\&quot; /Y /R /I&#xD;&#xA;" />
	</Target>

</Project>